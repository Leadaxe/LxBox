{
  "_note": "§480 — секция-маппер вида источника xray у vmess. Списано с xray_mapper.dart (_vmess). Данные: движок W1 вид источника xray сегодня не исполняет — секция кладётся впрок, вместе с uri-секцией того же протокола.",
  "mappers": {
    "xray": {
      "body_source": "xray",
      "detect": { "json": { "value_of": { "protocol": "vmess" } } },
      "forms": [
        {
          "id": "vnext",
          "detect": { "json": { "type_of": { "settings.vnext": "array" } } },
          "space": "json",
          "base": "settings.vnext.0"
        }
      ],
      "defaults": { "type": "vmess", "server_port": 443 },
      "params": {
        "address": {
          "source": "json.$base.address",
          "maps_to": "server",
          "required": true
        },
        "port": {
          "source": "json.$base.port",
          "maps_to": "server_port",
          "type": "int",
          "materialize_default": true
        },
        "id": {
          "source": "json.$base.users.0.id",
          "maps_to": "uuid",
          "required": true
        },
        "security": {
          "source": "json.$base.users.0.security",
          "maps_to": "security",
          "normalize": "trim_lower",
          "materialize_default": true,
          "value_map": {
            "chacha20-ietf-poly1305": "chacha20-poly1305",
            "": "auto",
            "null": "auto",
            "undefined": "auto"
          },
          "desc_ru": "§459 — то же правило написания, что у маппера ссылки. Ключ обязан ПОЯВИТЬСЯ в теле даже при пустом значении: у ядра поле без omitempty, опущенный ключ снял бы узел кодом field_missing. Годность судит реестр (enum + on_invalid coerce auto)."
        },
        "alterId": {
          "source": "json.$base.users.0.alterId",
          "maps_to": "alter_id",
          "type": "int",
          "materialize_default": true,
          "desc_ru": "В отличие от ссылки, здесь alter_id пишется ВСЕГДА, в том числе нулём (прежняя ветка Xray клала его безусловно)."
        },
        "$extra_vnext": {
          "source": "json.settings.vnext",
          "maps_to": null,
          "on_len_gt": {
            "n": 1,
            "action": "note",
            "code": "xray_extra_entries_dropped"
          },
          "desc_ru": "vnext[1..] отбрасываются; сегодня молча."
        },
        "$extra_users": {
          "source": "json.$base.users",
          "maps_to": null,
          "on_len_gt": {
            "n": 1,
            "action": "note",
            "code": "xray_extra_entries_dropped"
          }
        }
      },
      "include": ["transports#xray", "tls#xray", "dialer.keep_alive#xray"],
      "unknown_key": { "action": "drop", "code": "json_field_unknown" },
      "emit": null
    }
  }
}
