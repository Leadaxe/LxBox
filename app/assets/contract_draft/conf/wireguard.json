{
  "mappers": {
    "conf": {
      "detect": {
        "ini": {
          "sections": [
            "Interface"
          ]
        }
      },
      "body_source": "wgconf",
      "forms": [
        {
          "id": "awg3",
          "detect": {
            "ini": {
              "keys_any": [
                "HeaderProtectionKey",
                "ContentPaddingAddition",
                "RekeyAfterTime",
                "RekeyTimeout",
                "RejectAfterTime",
                "KeepaliveTimeout",
                "MaxHandshakeAttempts",
                "RandomTrailers",
                "DisableCookies"
              ]
            }
          },
          "space": "ini",
          "level": "endpoint"
        },
        {
          "id": "awg",
          "detect": {
            "ini": {
              "keys_any": [
                "Jc",
                "Jmin",
                "Jmax",
                "S1",
                "S2",
                "S3",
                "S4",
                "H1",
                "H2",
                "H3",
                "H4",
                "I1",
                "I2",
                "I3",
                "I4",
                "I5"
              ]
            }
          },
          "space": "ini",
          "level": "endpoint"
        },
        {
          "id": "wg",
          "detect": {
            "default": true
          },
          "space": "ini",
          "level": "endpoint"
        }
      ],
      "ini_dialect": {
        "key_case": "lower",
        "value_case": "preserve",
        "line_comment_prefixes": [
          "#",
          ";"
        ],
        "inline_comments": false,
        "repeated_key": "last_wins",
        "sections": {
          "Peer": {
            "repeat": "first_only",
            "on_extra": {
              "$code_pending": "wgconf_extra_peer_dropped",
              "$impl": "Тот же случай, что у dns: контракт 1.1.22 привёз ТЕКСТ кода (warnings.json, severity warning), но корпус его не ждёт, а `desc` самого кода говорит «сегодня Go делает это молча» (parseWGConfSections). Включать раньше корпуса значит расходиться с лаунчером на живых узлах."
            }
          }
        },
        "on_extra": {
          "action": "drop"
        },
        "impl": "DRAFT-атрибут грамматики. Наш разбор дословно: ключи в lower, значения as-is, комментарии '#'/';' только целой строкой, повторяющийся ключ — последний выигрывает, секции кроме [Interface]/[Peer] игнорируются, читается ТОЛЬКО первая [Peer]."
      },
      "defaults": {
        "peers[].port": 51820
      },
      "label": {
        "source": [
          "ini.$comment.Peer",
          "hint"
        ],
        "normalize": [
          "strip_control",
          "trim"
        ],
        "fallback": {
          "template": "WireGuard"
        }
      },
      "params": {
        "$label_chain": {
          "source": "ini.Peer.Endpoint",
          "maps_to": null,
          "impl": "§456 — INI тега не несёт, и цепочка метки у ДВУХ входов этой секции разная. Файл: комментарий под [Peer] без '=' (Proton пишет туда '# CH-FREE#11') → nameHint вызывающего (имя файла при импорте, тег записи, поле Tag редактора) → 'WireGuard'. Ссылка awg://<base64 .conf>: фрагмент → ХОСТ Endpoint (зеркало Go ConvertWGConfText, §450, тест awg_test 'без фрагмента метка = хост Endpoint') → и только потом общий фолбэк. Поэтому у ссылочной формы шага 'WireGuard' на корпусе не достигается."
        },
        "privatekey": {
          "source": "ini.Interface.PrivateKey",
          "maps_to": "private_key",
          "normalize": "base64_std",
          "required": true
        },
        "address": {
          "source": "ini.Interface.Address",
          "maps_to": "address",
          "list": {
            "sep": ","
          },
          "normalize": "cidr_prefix",
          "required": true
        },
        "mtu": {
          "source": "ini.Interface.MTU",
          "maps_to": "mtu",
          "type": "int"
        },
        "dns": {
          "source": "ini.Interface.DNS",
          "maps_to": null,
          "on_present": {
            "action": "note",
            "$code_pending": "wgconf_dns_ignored"
          },
          "impl": "У sing-box endpoint dns-поля нет — лоссы by design (wireguard.json uri.query.dns.impl). Контракт 1.1.22 привёз ТЕКСТ кода (warnings.json, severity info), но КОРПУС его не ждёт: ни один кейс `contract/corpus/**` не несёт `wgconf_*`, а `wgconf/ini_basic.body` ждёт пустой список warnings. Сам реестр секции `mappers.conf` ещё не объявил (поле `go` кода ссылается на неё вперёд), и `desc` кода говорит «сегодня Go делает это молча». Включить код у себя значит разойтись с лаунчером на живых узлах — поэтому имя остаётся под `$code_pending` до правки корпуса. `$`-ключ движок не читает (служебная запись). Запись обязана остаться в любом случае: без неё DNS уехал бы в `uri_param_unknown`."
        },
        "publickey": {
          "source": "ini.Peer.PublicKey",
          "maps_to": "peers[].public_key",
          "normalize": "base64_std",
          "required": true
        },
        "presharedkey": {
          "source": "ini.Peer.PresharedKey",
          "aliases": [
            "preshared_key"
          ],
          "maps_to": "peers[].pre_shared_key",
          "normalize": "base64_std"
        },
        "allowedips": {
          "source": "ini.Peer.AllowedIPs",
          "maps_to": "peers[].allowed_ips",
          "list": {
            "sep": ","
          },
          "normalize": "cidr_prefix",
          "default_when": {
            "absent": true,
            "value": "0.0.0.0/0,::/0"
          },
          "materialize_default": true,
          "impl": "§103 amnezia_vpn_plain_wg — читать обязательно: без этого IPv4-only INI получал дефолтный ::/0 в придачу."
        },
        "endpoint": {
          "source": "ini.Peer.Endpoint",
          "selector": true,
          "required": true,
          "extract": {
            "re": "^(?:\\[(?P<h6>[^\\]]+)\\](?::(?P<p6>\\d+))?|(?P<h>[^:]+):(?P<p>\\d+))$",
            "into": {
              "h6": "peers[].address",
              "p6": {
                "path": "peers[].port",
                "type": "int"
              },
              "h": "peers[].address",
              "p": {
                "path": "peers[].port",
                "type": "int"
              }
            }
          },
          "on_no_match": {
            "action": "take_all",
            "into": "peers[].address",
            "defaults": {
              "peers[].port": 51820
            }
          },
          "impl": "G7 — [IPv6]:port, host:port и ГОЛЫЙ IPv6 (§219: несколько ':' без скобок — адрес целиком, порт по умолчанию 51820, потому что отличить его нечем). Пустой Endpoint — узла нет."
        },
        "keepalive": {
          "source": "ini.Peer.PersistentKeepalive",
          "maps_to": "peers[].persistent_keepalive_interval",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop"
          }
        },
        "reserved": {
          "source": "ini.Peer.Reserved",
          "aliases": [
            "client_id",
            "clientid"
          ],
          "maps_to": "peers[].reserved",
          "list": {
            "sep": ",",
            "item": "int",
            "len": 3
          },
          "on_invalid": {
            "action": "drop"
          },
          "impl": "§126 — WARP client_id: десятичная тройка либо base64 трёх байт."
        },
        "jc": {
          "source": "ini.Interface.Jc",
          "maps_to": "jc",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "jmin": {
          "source": "ini.Interface.Jmin",
          "maps_to": "jmin",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "jmax": {
          "source": "ini.Interface.Jmax",
          "maps_to": "jmax",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "s1": {
          "source": "ini.Interface.S1",
          "maps_to": "s1",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "s2": {
          "source": "ini.Interface.S2",
          "maps_to": "s2",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "s3": {
          "source": "ini.Interface.S3",
          "maps_to": "s3",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "s4": {
          "source": "ini.Interface.S4",
          "maps_to": "s4",
          "type": "int",
          "on_invalid": {
            "action": "drop"
          }
        },
        "h1": {
          "source": "ini.Interface.H1",
          "maps_to": "h1",
          "normalize": "range_order:swap",
          "on_invalid": {
            "action": "drop",
            "code": "awg_header_invalid"
          }
        },
        "h2": {
          "source": "ini.Interface.H2",
          "maps_to": "h2",
          "normalize": "range_order:swap",
          "on_invalid": {
            "action": "drop",
            "code": "awg_header_invalid"
          }
        },
        "h3": {
          "source": "ini.Interface.H3",
          "maps_to": "h3",
          "normalize": "range_order:swap",
          "on_invalid": {
            "action": "drop",
            "code": "awg_header_invalid"
          }
        },
        "h4": {
          "source": "ini.Interface.H4",
          "maps_to": "h4",
          "normalize": "range_order:swap",
          "on_invalid": {
            "action": "drop",
            "code": "awg_header_invalid"
          }
        },
        "i1": {
          "source": "ini.Interface.I1",
          "maps_to": "i1"
        },
        "i2": {
          "source": "ini.Interface.I2",
          "maps_to": "i2"
        },
        "i3": {
          "source": "ini.Interface.I3",
          "maps_to": "i3"
        },
        "i4": {
          "source": "ini.Interface.I4",
          "maps_to": "i4"
        },
        "i5": {
          "source": "ini.Interface.I5",
          "maps_to": "i5"
        },
        "id": {
          "source": "ini.Interface.Id",
          "maps_to": "id"
        },
        "ip": {
          "source": "ini.Interface.Ip",
          "maps_to": "ip"
        },
        "ib": {
          "source": "ini.Interface.Ib",
          "maps_to": "ib"
        },
        "headerprotectionkey": {
          "source": "ini.Interface.HeaderProtectionKey",
          "maps_to": "header_protection_key"
        },
        "contentpaddingaddition": {
          "source": "ini.Interface.ContentPaddingAddition",
          "maps_to": "content_padding_addition",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop",
            "code": "awg3_field_invalid"
          }
        },
        "rekeyaftertime": {
          "source": "ini.Interface.RekeyAfterTime",
          "maps_to": "rekey_after_time",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop",
            "code": "awg3_field_invalid"
          }
        },
        "rekeytimeout": {
          "source": "ini.Interface.RekeyTimeout",
          "maps_to": "rekey_timeout",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop",
            "code": "awg3_field_invalid"
          }
        },
        "rejectaftertime": {
          "source": "ini.Interface.RejectAfterTime",
          "maps_to": "reject_after_time",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop",
            "code": "awg3_field_invalid"
          }
        },
        "keepalivetimeout": {
          "source": "ini.Interface.KeepaliveTimeout",
          "maps_to": "keepalive_timeout",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop",
            "code": "awg3_field_invalid"
          }
        },
        "maxhandshakeattempts": {
          "source": "ini.Interface.MaxHandshakeAttempts",
          "maps_to": "max_handshake_attempts",
          "normalize": "range_order:strict",
          "on_invalid": {
            "action": "drop",
            "code": "awg3_field_invalid"
          }
        },
        "randomtrailers": {
          "source": "ini.Interface.RandomTrailers",
          "maps_to": "random_trailers",
          "value_map": {
            "on": true,
            "true": true,
            "1": true,
            "off": null,
            "false": null,
            "0": null
          },
          "impl": "§421 — набор написаний у AWG 3.1 СВОЙ: `on` наравне с `true`/`1`, а выключенное даёт ОТСУТСТВИЕ ключа, не `false` (лишний ключ сдвинул бы identity-хеш). Общий `bool_spelled` (§4 FROZEN: 1|true|yes) ни `on`, ни `off` не знает, поэтому набор объявлен записью — закрытый набор написаний это ровно `value_map`, заводить второй булев примитив незачем."
        },
        "disablecookies": {
          "source": "ini.Interface.DisableCookies",
          "maps_to": "disable_cookies",
          "value_map": {
            "on": true,
            "true": true,
            "1": true,
            "off": null,
            "false": null,
            "0": null
          }
        }
      },
      "kind_when": {
        "awg": {
          "any_set": [
            "ini.Interface.Jc",
            "ini.Interface.Jmin",
            "ini.Interface.Jmax",
            "ini.Interface.S1",
            "ini.Interface.S2",
            "ini.Interface.S3",
            "ini.Interface.S4",
            "ini.Interface.H1",
            "ini.Interface.H2",
            "ini.Interface.H3",
            "ini.Interface.H4",
            "ini.Interface.I1",
            "ini.Interface.I2",
            "ini.Interface.I3",
            "ini.Interface.I4",
            "ini.Interface.I5",
            "ini.Interface.Id",
            "ini.Interface.Ip",
            "ini.Interface.Ib",
            "ini.Interface.HeaderProtectionKey",
            "ini.Interface.ContentPaddingAddition",
            "ini.Interface.RekeyAfterTime",
            "ini.Interface.RekeyTimeout",
            "ini.Interface.RejectAfterTime",
            "ini.Interface.KeepaliveTimeout",
            "ini.Interface.MaxHandshakeAttempts",
            "ini.Interface.RandomTrailers",
            "ini.Interface.DisableCookies"
          ],
          "$impl": "G1 — род узла объявляет ВХОД, а не уцелевшие поля тела. Зеркало kind_when секции uri: потолок и дефолт MTU — свойство ЗАПРОШЕННОГО протокола, и вход может попросить AmneziaWG, не донеся ни одного годного поля."
        }
      },
      "scheme_sets": {
        "*": {
          "type": "wireguard"
        }
      },
      "unknown_key": {
        "action": "drop",
        "code": "uri_param_unknown"
      },
      "emit": null
    }
  }
}
