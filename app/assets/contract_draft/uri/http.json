{
  "_note": "§480 — секция-маппер ссылки http(s) CONNECT-прокси (§222). Схема кастомная: голые http(s):// перехватывает isSubscriptionUrl раньше isDirectLink. Суффикс схемы — TLS-дискриминатор, четыре написания (дефис- и плюс-формы §268).",
  "mappers": {
    "uri": {
      "body_source": "uri",
      "detect": {
        "scheme_in": [
          "proxy-http",
          "proxy-https",
          "proxy+http",
          "proxy+https"
        ]
      },
      "forms": [
        {
          "id": "url",
          "detect": {
            "default": true
          },
          "decode": [
            "url"
          ],
          "space": "url"
        }
      ],
      "userinfo": {
        "split": {
          "sep": ":",
          "limit": 2
        },
        "into": [
          "username",
          "password"
        ],
        "single_into": "username",
        "_desc_ru": "Три формы: 'user' | 'user:pass' | ':pass' — оба компонента опциональны (uri.userinfo.impl). Пароль — всё после ПЕРВОГО двоеточия."
      },
      "label": {
        "source": "fragment",
        "normalize": [
          "strip_control",
          "trim"
        ],
        "fallback": {
          "template": "{scheme}-{server}-{server_port}",
          "scheme_source": "singbox_type"
        }
      },
      "defaults": {
        "type": "http"
      },
      "scheme_sets": {
        "proxy-https": {
          "tls.enabled": true,
          "$default_port": 443
        },
        "proxy+https": {
          "tls.enabled": true,
          "$default_port": 443
        },
        "proxy-http": {
          "$default_port": 80
        },
        "proxy+http": {
          "$default_port": 80
        }
      },
      "params": {
        "server": {
          "source": "host",
          "maps_to": "server",
          "required": true
        },
        "server_port": {
          "source": "port",
          "maps_to": "server_port",
          "type": "int",
          "materialize_default": true,
          "desc_ru": "Дефолт задаёт scheme_sets: 443 у https-суффикса, 80 у http-суффикса."
        },
        "username": {
          "source": "userinfo.user",
          "maps_to": "username"
        },
        "password": {
          "source": "userinfo.pass",
          "maps_to": "password"
        },
        "path": {
          "source": "query.path",
          "maps_to": "path",
          "desc_ru": "Читается у ОБОИХ суффиксов — так делал прежний путь."
        },
        "headers": {
          "source": "query.headers",
          "maps_to": "headers",
          "type": "object",
          "sort_keys": true,
          "list": {
            "sep": "\r\n"
          },
          "extract": {
            "re": "^(?P<k>[^:]+):\\s*(?P<v>.*)$",
            "into": {
              "k": "$key",
              "v": "$value"
            }
          },
          "desc_ru": "Та же сериализация, что extra-headers у naive: 'H1: V1\\r\\nH2: V2' → карта тела. sort_keys — порядок ключей входит в тело, то есть в identity. Битая пара пропускается МОЛЧА: код naive_extra_headers_invalid объявлен у naive, и под контракт эти заголовки не попадают (так было и на прежнем пути)."
        }
      },
      "include": [
        "tls#uri.trojan_convention",
        "dialer.keep_alive#uri"
      ],
      "unknown_key": {
        "action": "drop",
        "code": "uri_param_unknown"
      },
      "emit": {
        "form": "url",
        "form_from": {
          "tls.enabled": {
            "true": "proxy-https",
            "*": "proxy-http"
          }
        },
        "param_order": [
          "headers",
          "path"
        ]
      }
    }
  }
}
