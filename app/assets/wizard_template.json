{
  "parser_config": {
    "version": 5,
    "parser": {
      "reload": "12h"
    }
  },

  "dns_options": {
    "servers": [
      {
        "description": "System DNS", "enabled": true,
        "server": {
          "type": "local", "tag": "local_dns_resolver"
        }
      },

      {
        "description": "Google DNS (direct)", "enabled": true,
        "vars": [
          {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Which channel carries DNS queries to this server"},
          {"name": "dns_ip", "type": "enum", "default_value": "8.8.8.8", "title": "UDP server IP", "tooltip": "Google Public DNS address. IPv4 — universal; IPv6 — if your network supports it.", "options": [
            {"title": "8.8.8.8 · Primary v4",   "value": "8.8.8.8"},
            {"title": "8.8.4.4 · Secondary v4", "value": "8.8.4.4"},
            {"title": "2001:4860:4860::8888 · Primary v6",   "value": "2001:4860:4860::8888"},
            {"title": "2001:4860:4860::8844 · Secondary v6", "value": "2001:4860:4860::8844"}
          ]}
        ],
        "server": {
          "type": "udp", "tag": "google_udp", "server_port": 53,
          "server": "@dns_ip",
          "detour": "@outbound"
        }
      },
      {
        "description": "Google DoT", "enabled": false,
        "vars": [
          {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Which channel carries DNS queries to this server"},
          {"name": "dns_ip", "type": "enum", "default_value": "8.8.8.8", "title": "DoT server IP", "tooltip": "Google Public DNS address for DNS-over-TLS (port 853).", "options": [
            {"title": "8.8.8.8 · Primary v4",   "value": "8.8.8.8"},
            {"title": "8.8.4.4 · Secondary v4", "value": "8.8.4.4"},
            {"title": "2001:4860:4860::8888 · Primary v6",   "value": "2001:4860:4860::8888"},
            {"title": "2001:4860:4860::8844 · Secondary v6", "value": "2001:4860:4860::8844"}
          ]}
        ],
        "server": {
          "type": "tls", "tag": "google_dot", "server_port": 853,
          "server": "@dns_ip",
          "detour": "@outbound"
        }
      },
      {
        "description": "Google DoH", "enabled": false,
        "vars": [
          {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Which channel carries DNS queries to this server"},
          {"name": "dns_ip", "type": "enum", "default_value": "8.8.8.8", "title": "DoH server IP", "tooltip": "Google Public DNS IP for IP-based DoH. TLS SNI is pinned to dns.google.", "options": [
            {"title": "8.8.8.8 · Primary v4",   "value": "8.8.8.8"},
            {"title": "8.8.4.4 · Secondary v4", "value": "8.8.4.4"},
            {"title": "2001:4860:4860::8888 · Primary v6",   "value": "2001:4860:4860::8888"},
            {"title": "2001:4860:4860::8844 · Secondary v6", "value": "2001:4860:4860::8844"}
          ]}
        ],
        "server": {
          "type": "https", "tag": "google_doh", "server_port": 443, "path": "/dns-query", "tls": {"enabled": true, "server_name": "dns.google"},
          "server": "@dns_ip",
          "detour": "@outbound"
        }
      },

      {
        "description": "Cloudflare UDP", "enabled": true,
        "vars": [
          {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Which channel carries DNS queries to this server"},
          {"name": "dns_ip", "type": "enum", "default_value": "1.1.1.1", "title": "UDP server IP", "tooltip": "Cloudflare Public DNS address. IPv4 — universal; IPv6 — if your network supports it.", "options": [
            {"title": "1.1.1.1 · Primary v4",   "value": "1.1.1.1"},
            {"title": "1.0.0.1 · Secondary v4", "value": "1.0.0.1"},
            {"title": "2606:4700:4700::1111 · Primary v6",   "value": "2606:4700:4700::1111"},
            {"title": "2606:4700:4700::1001 · Secondary v6", "value": "2606:4700:4700::1001"}
          ]}
        ],
        "server": {
          "type": "udp", "tag": "cloudflare_udp", "server_port": 53,
          "server": "@dns_ip",
          "detour": "@outbound"
        }
      },
      {
        "description": "Cloudflare DoT", "enabled": false,
        "vars": [
          {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Which channel carries DNS queries to this server"},
          {"name": "dns_ip", "type": "enum", "default_value": "1.1.1.1", "title": "DoT server IP", "tooltip": "Cloudflare Public DNS address for DNS-over-TLS (port 853).", "options": [
            {"title": "1.1.1.1 · Primary v4",   "value": "1.1.1.1"},
            {"title": "1.0.0.1 · Secondary v4", "value": "1.0.0.1"},
            {"title": "2606:4700:4700::1111 · Primary v6",   "value": "2606:4700:4700::1111"},
            {"title": "2606:4700:4700::1001 · Secondary v6", "value": "2606:4700:4700::1001"}
          ]}
        ],
        "server": {
          "type": "tls", "tag": "cloudflare_dot", "server_port": 853,
          "server": "@dns_ip",
          "detour": "@outbound"
        }
      },

      {
        "description": "Safe DNS (DoT)", "enabled": false,
        "vars": [
          {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Which channel carries DNS queries to this server"},
          {"name": "safe_profile", "type": "enum", "default_value": "9.9.9.9", "title": "Safe profile", "tooltip": "DNS-over-TLS with built-in blocking: malware (Quad9), ads (AdGuard), or ads + adult (AdGuard Family).", "options": [
            {"title": "Quad9 · anti-malware",          "value": "9.9.9.9"},
            {"title": "AdGuard · ad block",            "value": "dns.adguard-dns.com"},
            {"title": "AdGuard Family · ad + adult",   "value": "family.adguard-dns.com"}
          ]},
          {"name": "dom_resolver", "type": "dns_servers", "default_value": "google_udp", "title": "Domain resolver", "tooltip": "DNS server used to resolve the Safe DNS hostname itself (AdGuard profiles use a domain address)."}
        ],
        "server": {
          "type": "tls", "tag": "safe_dns_dot", "server_port": 853,
          "server": "@safe_profile",
          "domain_resolver": "@dom_resolver",
          "detour": "@outbound"
        }
      }
    ],
    "rules": []
  },

  "ping_options": {
    "url": "https://www.gstatic.com/generate_204",
    "timeout_ms": 5000,
    "presets": [
      {"name": "Google 204", "url": "https://www.gstatic.com/generate_204"},
      {"name": "Cloudflare", "url": "https://cp.cloudflare.com/generate_204"},
      {"name": "Apple", "url": "https://captive.apple.com/hotspot-detect.html"},
      {"name": "Firefox", "url": "https://detectportal.firefox.com/canonical.html"},
      {"name": "Yandex", "url": "https://ya.ru/"}
    ]
  },

  "speed_test_options": {
    "servers": [
      {"name": "Cloudflare", "download_url": "https://speed.cloudflare.com/__down?bytes=25000000", "upload_url": "https://speed.cloudflare.com/__up", "upload_method": "POST", "ping_url": "https://speed.cloudflare.com/__down?bytes=0"},
      {"name": "Hostkey (Moscow)", "download_url": "https://spd-rudp.hostkey.ru/files/10mb.bin", "ping_url": "https://spd-rudp.hostkey.ru/"},
      {"name": "Selectel (RU)", "download_url": "https://speedtest.selectel.ru/10MB", "ping_url": "https://speedtest.selectel.ru/"},
      {"name": "Hostkey (Frankfurt)", "download_url": "https://spd-desrv.hostkey.com/files/10mb.bin", "ping_url": "https://spd-desrv.hostkey.com/"},
      {"name": "Hostkey (Amsterdam)", "download_url": "https://spd-nlsrv.hostkey.com/files/10mb.bin", "ping_url": "https://spd-nlsrv.hostkey.com/"},
      {"name": "Hostkey (Helsinki)", "download_url": "https://spd-fisrv.hostkey.com/files/10mb.bin", "ping_url": "https://spd-fisrv.hostkey.com/"},
      {"name": "Hostkey (New York)", "download_url": "https://spd-uswb.hostkey.com/files/10mb.bin", "ping_url": "https://spd-uswb.hostkey.com/"},
      {"name": "Tele2 (EU)", "download_url": "http://speedtest.tele2.net/10MB.zip", "upload_url": "http://speedtest.tele2.net/upload.php", "ping_url": "http://speedtest.tele2.net/"},
      {"name": "OVH (France)", "download_url": "https://proof.ovh.net/files/10Mb.dat", "ping_url": "https://proof.ovh.net/"},
      {"name": "ThinkBroadband (UK)", "download_url": "http://ipv4.download.thinkbroadband.com/10MB.zip", "ping_url": "http://ipv4.download.thinkbroadband.com/"}
    ],
    "stream_options": [1, 4, 10],
    "default_streams": 4
  },

  "preset_groups": [
    {
      "tag": "@auto_proxy_tag",
      "type": "urltest",
      "label": "Include Auto",
      "default_enabled": true,
      "options": {
        "url": "@urltest_url",
        "interval": "@urltest_interval",
        "tolerance": "@urltest_tolerance",
        "interrupt_exist_connections": true
      },
      "add_outbounds": []
    },
    {
      "tag": "vpn-1",
      "type": "selector",
      "label": "VPN ①",
      "default_enabled": true,
      "options": {
        "interrupt_exist_connections": true,
        "default": "@auto_proxy_tag"
      },
      "add_outbounds": ["direct-out", "@auto_proxy_tag"]
    },
    {
      "tag": "vpn-2",
      "type": "selector",
      "label": "VPN ②",
      "default_enabled": false,
      "options": {
        "default": "direct-out",
        "interrupt_exist_connections": true
      },
      "add_outbounds": ["direct-out", "@auto_proxy_tag"]
    },
    {
      "tag": "vpn-3",
      "type": "selector",
      "label": "VPN ③",
      "default_enabled": false,
      "options": {
        "default": "direct-out",
        "interrupt_exist_connections": true
      },
      "add_outbounds": ["direct-out", "@auto_proxy_tag"]
    }
  ],

  "sections": [
    {
      "name": "General",
      "chapter": "core",
      "description": "Logging and core settings",
      "vars": [
        {
          "name": "log_level",
          "type": "enum",
          "default_value": "warn",
          "options": ["trace", "debug", "info", "warn", "error", "fatal", "panic"],
          "wizard_ui": "edit",
          "title": "Log level",
          "tooltip": "Verbosity of sing-box logs"
        },
        {
          "name": "auto_proxy_tag",
          "type": "text",
          "default_value": "✨auto",
          "wizard_ui": "hidden",
          "title": "Auto proxy tag",
          "tooltip": "Internal — tag of the URLTest group. Read-only."
        }
      ]
    },
    {
      "name": "Clash API",
      "chapter": "core",
      "description": "Real-time proxy management interface",
      "vars": [
        {
          "name": "clash_api",
          "type": "text",
          "default_value": "127.0.0.1:9090",
          "wizard_ui": "edit",
          "title": "Address",
          "tooltip": "Host:port for Clash API"
        },
        {
          "name": "clash_secret",
          "type": "secret",
          "default_value": "",
          "wizard_ui": "edit",
          "title": "Secret",
          "tooltip": "Authentication secret for Clash API"
        }
      ]
    },
    {
      "name": "Network",
      "chapter": "core",
      "description": "Connection and routing behavior",
      "vars": [
        {
          "name": "resolve_strategy",
          "type": "enum",
          "default_value": "prefer_ipv4",
          "options": ["prefer_ipv4", "prefer_ipv6", "ipv4_only", "ipv6_only"],
          "wizard_ui": "edit",
          "title": "Resolve strategy",
          "tooltip": "IP version preference for DNS resolution"
        },
        {
          "name": "auto_detect_interface",
          "type": "bool",
          "default_value": "true",
          "wizard_ui": "edit",
          "title": "Auto-detect interface",
          "tooltip": "Automatically detect the default network interface"
        },
        {
          "name": "sniff_enabled",
          "type": "bool",
          "default_value": "true",
          "wizard_ui": "edit",
          "title": "Packet sniffing",
          "tooltip": "Detect protocol and domain from packets for accurate routing"
        }
      ]
    },
    {
      "name": "Auto Proxy",
      "chapter": "routing",
      "description": "URLTest tuning for the ✨auto group",
      "vars": [
        {
          "name": "urltest_url",
          "type": "text",
          "default_value": "https://cp.cloudflare.com/generate_204",
          "options": [
            "https://cp.cloudflare.com/generate_204",
            "https://www.gstatic.com/generate_204",
            "https://captive.apple.com/hotspot-detect.html"
          ],
          "wizard_ui": "edit",
          "title": "Test URL",
          "tooltip": "Endpoint for measuring proxy latency. Pick a preset or type any URL — 204 / tiny-body endpoints are best."
        },
        {
          "name": "urltest_interval",
          "type": "text",
          "default_value": "5m",
          "options": [
            "30s",
            "1m",
            "3m",
            "5m",
            "10m",
            "30m"
          ],
          "wizard_ui": "edit",
          "title": "Test interval",
          "tooltip": "How often sing-box re-tests and re-picks. Lower → faster first pick after connect, but more background traffic (1m typical, 5m conservative)."
        },
        {
          "name": "urltest_tolerance",
          "type": "text",
          "default_value": "30",
          "options": [
            "10",
            "30",
            "50",
            "100",
            "200"
          ],
          "wizard_ui": "edit",
          "title": "Tolerance (ms)",
          "tooltip": "Only switch proxy if latency difference exceeds this"
        }
      ]
    },
    {
      "name": "DNS",
      "chapter": "dns",
      "description": "Domain name resolution",
      "vars": [
        {
          "name": "dns_strategy",
          "type": "enum",
          "default_value": "prefer_ipv4",
          "options": ["prefer_ipv4", "prefer_ipv6", "ipv4_only", "ipv6_only"],
          "wizard_ui": "edit",
          "title": "Preferred IP version",
          "tooltip": "DNS resolution strategy"
        },
        {
          "name": "dns_default_domain_resolver",
          "type": "text",
          "default_value": "cloudflare_udp",
          "wizard_ui": "fix",
          "title": "Default domain resolver",
          "tooltip": "Used by routing engine to resolve hostnames internally (outbound endpoints, routing rules). Not the resolver apps use. Recommended: cloudflare_udp, google_udp, or google_doh. Avoid local_dns_resolver here — system DNS leaks these lookups to your ISP, bypassing the VPN."
        },
        {
          "name": "dns_final",
          "type": "text",
          "default_value": "local_dns_resolver",
          "wizard_ui": "fix",
          "title": "DNS final",
          "tooltip": "Default fallback DNS server. Used when an app's DNS query doesn't match any DNS rule. For privacy, prefer encrypted: google_doh, cloudflare_dot. For speed: cloudflare_udp, google_udp. local_dns_resolver (system DNS) is safe here."
        }
      ]
    },
    {
      "name": "TUN",
      "chapter": "core",
      "description": "Virtual network interface",
      "vars": [
        {
          "name": "tun_address",
          "type": "text",
          "default_value": "172.16.0.1/30",
          "wizard_ui": "edit",
          "title": "IPv4 address",
          "tooltip": "TUN interface address (CIDR)"
        },
        {
          "name": "tun_name",
          "type": "text",
          "default_value": "lxbox",
          "wizard_ui": "edit",
          "title": "TUN interface",
          "tooltip": "system name"
        },
        {
          "name": "tun_mtu",
          "type": "int",
          "default_value": "1492",
          "wizard_ui": "edit",
          "title": "MTU",
          "tooltip": "1492 recommended for mobile/WiFi"
        },
        {
          "name": "tun_auto_route",
          "type": "bool",
          "default_value": "true",
          "wizard_ui": "edit",
          "title": "Auto route",
          "tooltip": "Let sing-box manage routing table"
        },
        {
          "name": "tun_strict_route",
          "type": "bool",
          "default_value": "false",
          "wizard_ui": "edit",
          "title": "Strict route",
          "tooltip": "May break connectivity on some devices"
        },
        {
          "name": "tun_stack",
          "type": "enum",
          "default_value": "system",
          "options": ["system", "gvisor", "mixed"],
          "wizard_ui": "edit",
          "title": "Stack",
          "tooltip": "system (default), gvisor (userspace), mixed"
        }
      ]
    },
    {
      "name": "_vpn_mode_internal",
      "chapter": "core",
      "description": "§119/§120 — VPN-mode driven inbounds (hidden; values injected from VpnModeConfig at build time, type metadata only)",
      "vars": [
        {
          "name": "vpn_mode",
          "type": "enum",
          "default_value": "vpn",
          "options": ["vpn", "proxy", "vpn_proxy"],
          "wizard_ui": "hidden"
        },
        {
          "name": "proxy_type",
          "type": "text",
          "default_value": "mixed",
          "wizard_ui": "hidden"
        },
        {
          "name": "proxy_listen",
          "type": "text",
          "default_value": "127.0.0.1",
          "wizard_ui": "hidden"
        },
        {
          "name": "proxy_port",
          "type": "int",
          "default_value": "2080",
          "wizard_ui": "hidden"
        },
        {
          "name": "proxy_user",
          "type": "text",
          "default_value": "user",
          "wizard_ui": "hidden"
        },
        {
          "name": "proxy_pass",
          "type": "secret",
          "default_value": "",
          "wizard_ui": "hidden"
        },
        {
          "name": "proxy_auth",
          "type": "bool",
          "default_value": "false",
          "wizard_ui": "hidden"
        }
      ]
    },
    {
      "name": "DPI Bypass",
      "chapter": "core",
      "description": "TLS fragmentation to bypass censorship",
      "vars": [
        {
          "name": "tls_fragment",
          "type": "bool",
          "default_value": "false",
          "wizard_ui": "edit",
          "title": "TLS Fragment",
          "tooltip": "Split TLS ClientHello into small TCP segments"
        },
        {
          "name": "tls_record_fragment",
          "type": "bool",
          "default_value": "false",
          "wizard_ui": "edit",
          "title": "TLS Record Fragment",
          "tooltip": "Split handshake into multiple TLS records (try this first)"
        },
        {
          "name": "tls_fragment_fallback_delay",
          "type": "text",
          "default_value": "500ms",
          "wizard_ui": "edit",
          "title": "Fallback delay",
          "tooltip": "Wait time when automatic detection fails"
        },
        {
          "name": "tls_mixed_case_sni",
          "type": "bool",
          "default_value": "false",
          "wizard_ui": "edit",
          "title": "Mixed-case SNI",
          "tooltip": "Randomize letter case in server_name (WwW.gOoGle.CoM). Bypasses simple exact-match DPI; ineffective against GFW-class filtering"
        }
      ]
    }
  ],

  "config": {
    "log": {
      "level": "@log_level",
      "timestamp": true
    },
    "dns": {
      "servers": [],
      "rules": [],
      "final": "@dns_final",
      "strategy": "@dns_strategy"
    },
    "inbounds": [
      {"#if": {"and": [{"@vpn_mode": {"#in": ["vpn", "vpn_proxy"]}}], "value": {
        "type": "tun",
        "tag": "tun-in",
        "interface_name": "@tun_name",
        "address": "@tun_address",
        "mtu": "@tun_mtu",
        "auto_route": "@tun_auto_route",
        "strict_route": "@tun_strict_route",
        "stack": "@tun_stack"
      }}},
      {"#if": {"and": [{"@vpn_mode": {"#in": ["proxy", "vpn_proxy"]}}], "value": {
        "type": "@proxy_type",
        "tag": "mixed-in",
        "listen": "@proxy_listen",
        "listen_port": "@proxy_port",
        "#if": {"and": ["@proxy_auth"], "value": {
          "users": [{"username": "@proxy_user", "password": "@proxy_pass"}]
        }}
      }}}
    ],
    "endpoints": [],
    "outbounds": [
      { "type": "direct", "tag": "direct-out" }
    ],
    "route": {
      "find_process": true,
      "default_domain_resolver": "@dns_default_domain_resolver",
      "rules": [
        { "action": "resolve",
          "inbound": [
            {"#if": {"and": [{"@vpn_mode": {"#in": ["vpn", "vpn_proxy"]}}],   "value": "tun-in"}},
            {"#if": {"and": [{"@vpn_mode": {"#in": ["proxy", "vpn_proxy"]}}], "value": "mixed-in"}}
          ],
          "strategy": "@resolve_strategy" },
        {"#if": {"and": ["@sniff_enabled"], "value": {
          "action": "sniff",
          "inbound": [
            {"#if": {"and": [{"@vpn_mode": {"#in": ["vpn", "vpn_proxy"]}}],   "value": "tun-in"}},
            {"#if": {"and": [{"@vpn_mode": {"#in": ["proxy", "vpn_proxy"]}}], "value": "mixed-in"}}
          ],
          "timeout": "1s"
        }}},
        { "protocol": "dns", "action": "hijack-dns" }
      ],
      "final": "vpn-1",
      "auto_detect_interface": "@auto_detect_interface"
    },
    "experimental": {
      "clash_api": {
        "external_controller": "@clash_api",
        "secret": "@clash_secret"
      },
      "cache_file": {
        "enabled": true,
        "path": "cache.db"
      }
    }
  },

  "selectable_rules": [
    {
      "preset_id": "block-ads",
      "label": "Block Ads",
      "description": "Reject ad-related connections. Downloads rule set (~1 MB).",
      "default": false,
      "rule_set": [
        { "tag": "ads-all", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-category-ads-all.srs" }
      ],
      "rule": { "rule_set": "ads-all", "action": "reject" }
    },
    {
      "preset_id": "ru-direct",
      "label": "Russian domains & IPs",
      "description": "Route Russian TLDs (.ru/.su/IDN), service CDNs (Yandex/VK/Avito/2GIS/banks/etc) and Russian IP ranges directly.",
      "default": true,
      "vars": [
        {"name": "outbound", "type": "outbound", "default_value": "direct-out", "title": "Outbound", "tooltip": "Where to route traffic for Russian domains and IPs"},
        {"name": "dns_server", "type": "dns_servers", "required": false, "default_value": "yandex_udp", "title": "DNS server", "tooltip": "Recommended: Base/UDP — most stable. DoH/DoT may be filtered by ISPs."},
        {"name": "dns_ip", "type": "enum", "default_value": "77.88.8.8", "title": "UDP server IP", "tooltip": "Applies to UDP only. DoH and DoT are pinned to 77.88.8.88 with SNI safe.dot.dns.yandex.net.", "options": [
          {"title": "77.88.8.8 · Base",                  "value": "77.88.8.8"},
          {"title": "77.88.8.1 · Base alt",              "value": "77.88.8.1"},
          {"title": "2a02:6b8::feed:0ff · Base v6",      "value": "2a02:6b8::feed:0ff"},
          {"title": "77.88.8.88 · Safe",                 "value": "77.88.8.88"},
          {"title": "77.88.8.2 · Safe alt",              "value": "77.88.8.2"},
          {"title": "2a02:6b8::feed:bad · Safe v6",      "value": "2a02:6b8::feed:bad"},
          {"title": "2a02:6b8:0:1::feed:bad · Safe v6 alt", "value": "2a02:6b8:0:1::feed:bad"},
          {"title": "77.88.8.7 · Family",                "value": "77.88.8.7"},
          {"title": "77.88.8.3 · Family alt",            "value": "77.88.8.3"},
          {"title": "2a02:6b8::feed:a11 · Family v6",    "value": "2a02:6b8::feed:a11"}
        ]},
        {"name": "geoip_enabled", "type": "bool", "default_value": "true", "title": "GeoIP IP-range fallback", "tooltip": "Match Russian-AS IPs as well as domains — catches CDN/QUIC/ECH cases where domain detection fails. Auto-downloads geoip-ru.srs (~150 KB) on first use."}
      ],
      "rule_set": [
        {"tag": "ru-domains", "type": "inline", "rules": [{"domain_suffix": ["ru", "su", "xn--p1ai", "xn--p1acf", "xn--80adxhks", "moscow", "tatar", "xn--d1acj3b", "xn--80asehdb", "xn--80aswg", "xn--c1avg", "xn--j1aef"]}]},
        {"tag": "ru-services", "type": "inline", "rules": [{"domain_suffix": [
          "userapi.com", "avito.st", "yandex.net", "yandex.com", "yastatic.net",
          "2gis.com", "okko.tv", "premier.one", "lenta.com", "vk.com",
          "vk-portal.net", "gismeteo.com", "lmru.tech", "mradx.net",
          "wbstatic.net", "wildberries.by",
          "trbcdn.net", "sberbank.com"
        ]}]},
        {"tag": "geoip-ru", "enabled": "@geoip_enabled", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geoip/geoip-ru.srs", "update_interval": "168h"}
      ],
      "dns_rule": {"rule_set": ["ru-domains", "ru-services"], "server": "@dns_server"},
      "rule": {"rule_set": ["ru-domains", "ru-services", "geoip-ru"], "outbound": "@outbound"},
      "dns_servers": [
        {"type": "udp",   "tag": "yandex_udp", "server": "@dns_ip",    "server_port": 53,  "detour": "@outbound", "description": "Yandex UDP (IP from above)"},
        {"type": "https", "tag": "yandex_doh", "server": "77.88.8.88", "server_port": 443, "path": "/dns-query", "tls": {"enabled": true, "server_name": "safe.dot.dns.yandex.net"}, "detour": "@outbound", "description": "Yandex Safe DoH"},
        {"type": "tls",   "tag": "yandex_dot", "server": "77.88.8.88", "server_port": 853, "tls": {"enabled": true, "server_name": "safe.dot.dns.yandex.net"}, "detour": "@outbound", "description": "Yandex Safe DoT"}
      ]
    },
    {
      "preset_id": "ru-inside",
      "label": "Russia-only services direct",
      "description": "Services available only inside Russia — direct.",
      "rule_set": [
        { "tag": "ru-inside", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/runetfreedom/russia-v2ray-rules-dat/release/sing-box/rule-set-geosite/geosite-ru-available-only-inside.srs" }
      ],
      "rule": { "rule_set": "ru-inside", "outbound": "direct-out" }
    },
    {
      "preset_id": "bittorrent-direct",
      "label": "BitTorrent direct",
      "description": "Route BitTorrent traffic directly.",
      "default": true,
      "rule": { "protocol": ["bittorrent"], "outbound": "direct-out" }
    },
    {
      "preset_id": "private-ip-direct",
      "label": "Private IPs direct",
      "description": "Route private IP ranges (LAN) directly.",
      "rule": { "ip_is_private": true, "outbound": "direct-out" }
    },
    {
      "preset_id": "block_unknown",
      "label": "Block unknown traffic",
      "description": "Reject traffic in the tunnel not attributed to any installed app (background/foreign processes). Send it direct to bypass VPN instead.",
      "default": false,
      "vars": [
        {
          "name": "outbound",
          "type": "outbound",
          "default_value": "reject",
          "title": "outbound",
          "tooltip": "Reject = drop. Or pick Direct to send it outside the VPN."
        }
      ],
      "rule_set": [
        {
          "tag": "unknown-apps",
          "type": "inline",
          "rules": [
            { "invert": true, "package_name_regex": "^" }
          ]
        }
      ],
      "rule": {
        "rule_set": ["unknown-apps"],
        "outbound": "@outbound"
      }
    }
  ]
}
