<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse FGS-type появился в Android 14 (API 34). На младших
         API permission не запрашивается — minSdkVersion="34" гейтит его
         только для устройств где он реально что-то значит. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- §050 / F12.3 readWIFIState: sing-box DNS/routing rules с условиями
         `wifi_ssid:` / `wifi_bssid:` требуют чтения текущего WiFi SSID/BSSID
         через `WifiManager.getConnectionInfo()`. На API 29+ этот call требует
         ACCESS_BACKGROUND_LOCATION runtime grant; на API 28- — ACCESS_FINE_LOCATION.
         Без grant `getConnectionInfo()` бросает SecurityException → propagates
         через JNI в Go runtime → process abort. Permissions decl'арены как
         optional — юзер должен grant'нуть через Settings если использует
         wifi_ssid rules в config. См. spec/050 findings. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 13+ (API 33+): без NEARBY_WIFI_DEVICES `WifiInfo.ssid`
         возвращает "<unknown ssid>" даже если ACCESS_FINE_LOCATION granted.
         Для wifi_ssid/wifi_bssid правил sing-box нужно реальное имя. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- §047 Public Intent API — custom permission для строгого режима
         («Требовать пропуск»). Объявляется всегда (нужна когда юзер включил
         галку), но к receiver статически НЕ привязана через
         `android:permission` — манифест-атрибут нельзя переключить рантаймом,
         а защита опциональна. Enforcement — в коде (`LxBoxIntentReceiver.
         onReceive`). protectionLevel="normal": барьер «знать имя + declare»,
         не криптозащита; для сильной модели — package whitelist (future v2).
         `uses-permission` на себя — чтобы наши же outgoing-broadcast'ы в
         строгом режиме доходили до собственных тест-подписчиков. -->
    <permission
        android:name="com.leadaxe.lxbox.permission.AUTOMATION"
        android:protectionLevel="normal" />
    <uses-permission android:name="com.leadaxe.lxbox.permission.AUTOMATION" />

    <application
        android:label="L×Box"
        android:name=".vpn.BoxApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.BoxVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <!-- Android 14+ требует обоснование для foregroundServiceType="specialUse"
                 через PROPERTY_SPECIAL_USE_FGS_SUBTYPE — читается Play Store reviewer'ами,
                 в Android 15+ может показываться юзеру в системных FGS-настройках.
                 Стандартные FGS-типы (dataSync / mediaPlayback / connectedDevice)
                 не покрывают мультипротокольный VPN-стек с rule-based routing'ом. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel: managed multi-protocol VPN (VLESS / VMess / Trojan / Hysteria2 / WireGuard / NaïveProxy / Shadowsocks / SOCKS / SSH / TUIC) with rule-based routing engine." />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".vpn.LxBoxTileService"
            android:label="L×Box"
            android:icon="@drawable/ic_lxbox_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".vpn.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- §047 Public Intent API — приём automation-команд (Tasker /
             Macrodroid). `enabled="false"` по умолчанию: компонент включается
             рантаймом через PackageManager.setComponentEnabledSetting когда
             юзер поднимает мастер-toggle «Принимать команды автоматизации».
             `android:permission` НЕ задан — защита пропуском опциональна
             (галка «Требовать пропуск»), а манифест-атрибут статичен;
             enforcement делается в коде (`onReceive`). -->
        <receiver
            android:name=".vpn.LxBoxIntentReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="com.leadaxe.lxbox.START_VPN" />
                <action android:name="com.leadaxe.lxbox.STOP_VPN" />
                <action android:name="com.leadaxe.lxbox.TOGGLE_VPN" />
                <action android:name="com.leadaxe.lxbox.SWITCH_NODE" />
                <action android:name="com.leadaxe.lxbox.SET_GROUP" />
                <action android:name="com.leadaxe.lxbox.REBUILD_CONFIG" />
                <action android:name="com.leadaxe.lxbox.REFRESH_SUBS" />
                <action android:name="com.leadaxe.lxbox.RESET_NETWORK" />
                <action android:name="com.leadaxe.lxbox.URLTEST_GROUP" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
