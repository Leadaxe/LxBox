        }
      },
      {
        "kind": "template",
        "tag": "local_dns_resolver",
        "enabled": true
      },
      {
        "kind": "template",
        "tag": "google_udp",
        "enabled": true
      },
      {
        "kind": "template",
        "tag": "google_dot",
        "enabled": true,
        "description": "Google over TLS"
      },
      {
        "kind": "template",
        "tag": "google_doh",
        "enabled": true,
        "vars": {
          "outbound": "vpn-1",
          "dns_ip": "8.8.4.4"
        }
      },
      {
        "kind": "template",
        "tag": "cloudflare_udp",
        "enabled": false
      },
      {
        "kind": "template",
        "tag": "cloudflare_dot",
        "enabled": true
      },
      {
        "kind": "template",
        "tag": "safe_dns_dot",
        "enabled": false
      },
      {
        "kind": "template",
        "tag": "opendns_udp",
        "enabled": true
      },
      {
        "kind": "template",
        "tag": "quad9_doh",
        "enabled": true
      },
      {
        "kind": "template",
        "tag": "dns_shield",
        "enabled": true
      },
      {
        "kind": "preset",
        "ref": "ru-direct:dns_ru",
        "enabled": true
      },
      {
        "kind": "preset",
        "ref": "ru-direct:yandex_udp",
        "enabled": false,
        "description": "Yandex (off)"
      },
      {
        "kind": "preset",
        "ref": "ru-direct:yandex_dot",
        "enabled": true
      },
      {
        "kind": "preset",
        "ref": "ru-direct:yandex_doh",
        "enabled": true
      }
    ],
    "rules": [
      {
        "kind": "user",
        "name": "Local",
        "enabled": true,
        "body": {
          "domain_suffix": [
            ".lan"
          ],
          "server": "my-doh"
        }
      },
      {
        "kind": "user",
        "name": "Off rule",
        "enabled": false,
        "body": {
          "domain_suffix": [
            ".off"
          ],
          "server": "my-doh"
        }
      },
      {
        "kind": "user",
        "name": "No enabled key",
        "enabled": true,
        "body": {
          "domain_suffix": [
            ".nokey"
          ],
          "server": "google_udp"
        }
      },
      {
        "kind": "preset",
        "ref": "ru-direct",
        "enabled": true
      }
    ]
  },
  "vars": {
    "log_level": "debug",
    "tun_mtu": "1400",
    "tun_stack": "mixed",
    "dns_final": "my-doh",
    "dns_strategy": "prefer_ipv4",
